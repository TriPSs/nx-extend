{
  "tasksRunnerOptions": {
    "default": {
      "options": {
        "canTrackAnalytics": false,
        "showUsageWarnings": true
      }
    }
  },
  "tui": {
    "enabled": false
  },
  "workspaceLayout": {
    "appsDir": "e2e",
    "libsDir": "packages"
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "version": {
      "dependsOn": ["^version"],
      "inputs": ["production", "^production"],
      "options": {
        "trackDeps": true,
        "tagPrefix": "${target}@",
        "changelogHeader": " "
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "e2e": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/force-release"],
    "production": ["default", "!{projectRoot}/src/test-setup.[jt]s"]
  },
  "parallel": 1,
  "defaultBase": "master",
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "actions/plan/**/*",
        "packages/changelog-notify/**/*",
        "packages/core/**/*",
        "packages/docusaurus/**/*",
        "packages/e2e-runner/**/*",
        "packages/firebase-hosting/**/*",
        "packages/gcp-cloud-run/**/*",
        "packages/gcp-deployment-manager/**/*",
        "packages/gcp-functions/**/*",
        "packages/gcp-secrets/**/*",
        "packages/gcp-storage/**/*",
        "packages/gcp-task-runner/**/*",
        "packages/github-pages/**/*",
        "packages/playwright/**/*",
        "packages/pulumi/**/*",
        "packages/react-email/**/*",
        "packages/shadcn-ui/**/*",
        "packages/strapi/**/*",
        "packages/terraform/**/*",
        "packages/translations/**/*",
        "packages/vercel/**/*"
      ]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "e2e"
      },
      "include": [
        "e2e/docusaurus-e2e/**/*",
        "e2e/gcp-deployment-manager-e2e/**/*",
        "e2e/gcp-functions-e2e/**/*",
        "e2e/gcp-secrets-e2e/**/*",
        "e2e/react-email-e2e/**/*",
        "e2e/shadcn-ui-e2e/**/*",
        "e2e/strapi-e2e/**/*",
        "e2e/translations-e2e/**/*"
      ]
    }
  ]
}
