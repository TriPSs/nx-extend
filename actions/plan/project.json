{
  "name": "actions-plan",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "compile": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf ./actions/plan/dist",
          "npx esbuild ./actions/plan/src/plan.ts --bundle --platform=node --target=node24 --format=cjs --outfile=./actions/plan/dist/index.js",
          "cp ./node_modules/shelljs/src/exec-child.js ./actions/plan/dist/exec-child.js"
        ],
        "parallel": false
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "options": {
        "commands": [
          "git add ./actions/plan/dist -f || true",
          "git commit -m 'chore(actions-plan): Add dist' || true"
        ],
        "parallel": false
      }
    }
  }
}
