{
  "name": "actions-set-shas",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "targets": {
    "compile": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx esbuild ./actions/set-shas/src/set-shas.ts --bundle --platform=node --target=node24 --format=cjs --outfile=./actions/set-shas/dist/index.js"
        ]
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "compile"
      ],
      "options": {
        "commands": [
          "git add ./actions/set-shas/dist -f || true",
          "git commit -m 'chore(actions-set-shas): Add dist' || true"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
